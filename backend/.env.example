# Copy this file to ".env" (same folder) and fill in the values below.
# ".env" is where all your real, secret settings live — it is never
# shared or committed anywhere.

# Port the backend server runs on
PORT=4000

# A secret of your choosing, used to protect the GET /api/messages
# endpoint. Make this something random.
ADMIN_KEY=change-me-to-a-secret

# ------------------------------------------------------------------
# EMAIL (SMTP) SETTINGS
# ------------------------------------------------------------------
# These let the server email YOU whenever someone submits the form.
# Every submission is always saved to the database regardless, so
# nothing is lost even before you set this up.
#
# Easiest option — Gmail:
#   1. Turn on 2-Step Verification on your Google account.
#   2. Create an "App Password": https://myaccount.google.com/apppasswords
#   3. Use that 16-character app password below as SMTP_PASS
#      (NOT your normal Gmail password).
#
# Other providers (Outlook, Zoho, your own domain email, SendGrid,
# Mailgun, etc.) all work the same way — just use the SMTP host/port
# they give you.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password

# The address that notification emails are sent FROM.
FROM_EMAIL=your-email@gmail.com

# The address that notification emails are sent TO — i.e. where YOU
# want to receive new messages. Can be the same as FROM_EMAIL.
OWNER_EMAIL=your-email@gmail.com
